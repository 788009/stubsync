# ==========================================
# Android 增量备份配置文件
# ==========================================

# 备份文件的本地存储根目录
# 目录结构说明：
#   storage_root/
#     ├── data/       # 真实文件存储（可清理，仅作中转）
#     ├── backup.db   # 核心数据库（存储文件指纹，必须保留）
#     ├── _trash/     # 回收站（存放因手机端删除而同步删除的文件）
storage_root = "./test"

# 单次运行的最大备份流量限制 (单位: MB)
# 设置为 0 表示不限制流量
max_backup_size_mb = 2048000

# 需要备份的手机端目录列表 (绝对路径)
sources = [
    "/sdcard/DCIM"
]

# ==========================================
# 排除规则
# ==========================================
[excludes]
# 排除包含特定字符串的完整路径 (正则表达式)
paths = [
    "/.thumb",       # 排除缩略图目录
    "/cache"         # 排除缓存目录
]

# 排除特定的文件名 (正则表达式)
filenames = [
    "^\\.",          # 排除以点开头的文件 (.nomedia, .hidden 等)
    ".*\\.tmp$",     # 排除 tmp 后缀文件
    ".*\\.thumbnails$"
]

# ==========================================
# 连接模式设置
# ==========================================
[connection]
mode = ["adb", "ssh"]

# ==========================================
# SSH 配置 (仅在涉及 SSH 模式时生效)
# ==========================================
[ssh]
host = "192.168.1.100"    # 手机 IP 地址
port = 8022                # 端口 (Termux 默认 8022, SimpleSSHD 默认 2222)
username = "u0_a368"       # 用户名 (Termux 输入 `whoami` 查看)
password = "1"      # 密码 (二选一)
key_filename = ""          # 私钥路径 (二选一，留空则使用密码)

# SSH 传输最大速率 (单位: MB/s)
# 0 表示不限制 (可能会导致局域网卡顿)
# 仅在不限速时采用 tar 流
# 建议设置为 5.0 - 10.0
max_speed_mb = 5

# ==========================================
# 高级设置 (通常无需修改)
# ==========================================
[advanced]
# 删除行为:
#   "trash"     - 移动到 storage_root/_trash 目录 (推荐，安全)
#   "permanent" - 直接物理删除 (慎用)
delete_behavior = "trash"

# 多线程下载队列大小 (影响内存占用)
queue_max_size = 3

# 单次 ADB tar 命令打包的最大文件数
batch_max_files = 100

# 单次 ADB 命令行的最大字符数 (防止命令行过长溢出)
batch_max_chars = 7000